{
  "name": "practicalpodcast-server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend + pipeline for PracticalPodcast",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "e2e": "tsx scripts/e2e.ts",
    "prisma:gen": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx scripts/seed.ts",
    "seed:sample": "tsx scripts/seed.ts --sample",
    "pipeline": "tsx scripts/runPipelineNow.ts",
    "reset": "prisma migrate reset --force --skip-seed && tsx scripts/seed.ts --sample"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@prisma/client": "^6.19.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "nodemailer": "^9.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^25.9.3",
    "@types/nodemailer": "^8.0.1",
    "playwright": "^1.60.0",
    "prisma": "^6.19.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
