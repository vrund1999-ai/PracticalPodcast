# ---- Web app (always required) ----
PORT=3000
DATABASE_URL="file:./dev.db"
SESSION_SECRET="change-me-to-a-long-random-string"
OTP_PEPPER="change-me-to-another-long-random-string"
APP_TZ="America/New_York"

# ---- Pipeline providers (required only when running `npm run pipeline`) ----
# Anthropic Claude — AI script generation
ANTHROPIC_API_KEY=""

# NewsAPI.org — daily news sourcing
NEWSAPI_KEY=""

# ElevenLabs — text-to-speech for the two hosts
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_NOVA=""      # female voice id (Nova)
ELEVENLABS_VOICE_ATLAS=""     # male voice id (Atlas)

# ---- Email: Gmail SMTP (no domain needed; optional — falls back to console) ----
# Enable 2-Step Verification on the Google account, then create an App Password
# (Google Account -> Security -> App passwords) and paste the 16-char value.
GMAIL_USER="you@gmail.com"
GMAIL_APP_PASSWORD=""
FROM_EMAIL="PracticalPodcast <you@gmail.com>"

# ---- Dev knobs ----
# 0 = unlimited. >0 caps TTS lines per episode to save API credits while testing.
DEV_MAX_TTS_LINES=0
# When true, only the 10-minute episode is generated (skips 30/60 to save credits).
DEV_ONLY_SHORT=false
# When true (or with no Gmail creds), OTP codes are printed to the server console.
DEV_LOG_OTP=true
