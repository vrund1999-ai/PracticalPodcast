# ---- Web app (always required) ----
PORT=3000
DATABASE_URL="file:./dev.db"
SESSION_SECRET="change-me-to-a-long-random-string"
OTP_PEPPER="change-me-to-another-long-random-string"
APP_TZ="America/New_York"

# ---- Pipeline providers (required only when running `npm run pipeline`) ----
# Script generation model. "groq" = free (Llama 3.3 70B); "anthropic" = Claude.
# Only the selected provider's key is required.
LLM_PROVIDER="groq"

# Groq — free script generation (no credit card): https://console.groq.com/keys
GROQ_API_KEY=""
# Optional model override (defaults to llama-3.3-70b-versatile).
# GROQ_MODEL="llama-3.3-70b-versatile"

# Anthropic Claude — alternative script generation (LLM_PROVIDER="anthropic")
ANTHROPIC_API_KEY=""

# NewsAPI.org — daily news sourcing
NEWSAPI_KEY=""

# Text-to-speech provider. "edge" = free Microsoft neural voices (no key, no
# quota); "elevenlabs" = higher quality but needs a key + voice ids + quota.
TTS_PROVIDER="edge"
# Optional Edge voice overrides (defaults: Aria = Nova, Christopher = Atlas).
# EDGE_VOICE_NOVA="en-US-AriaNeural"
# EDGE_VOICE_ATLAS="en-US-ChristopherNeural"

# ElevenLabs — only needed when TTS_PROVIDER="elevenlabs"
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_NOVA=""      # female voice id (Nova) — use a premade voice on the free tier
ELEVENLABS_VOICE_ATLAS=""     # male voice id (Atlas)

# ---- Email: Gmail SMTP (no domain needed; optional — falls back to console) ----
# Enable 2-Step Verification on the Google account, then create an App Password
# (Google Account -> Security -> App passwords) and paste the 16-char value.
GMAIL_USER="you@gmail.com"
GMAIL_APP_PASSWORD=""
FROM_EMAIL="PracticalPodcast <you@gmail.com>"

# ---- Dev knobs ----
# 0 = unlimited. >0 caps TTS lines per episode to save API credits while testing.
DEV_MAX_TTS_LINES=0
# When true, only the 10-minute episode is generated (skips 30/60 to save credits).
DEV_ONLY_SHORT=false
# When true (or with no Gmail creds), OTP codes are printed to the server console.
DEV_LOG_OTP=true
